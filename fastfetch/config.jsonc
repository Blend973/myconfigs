// Inspired by Catnap (https://github.com/iinsertNameHere/catnap)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // "type": "file",
        // "source": "/usr/share/archcraft/artworks/ascii/archcraft-2"
        "source": "arch"
    },
    "display": {
        "separator": "",
        "key": {
            "width": 15
        }
    },
    "modules": [
        {
            // draw borders first to make colors of left and right border consistent
            "key": " user",
            "type": "title",
            "format": "{user-name}",
            "keyColor": "31"
        },
        {
            "key": "󰟀 host",
            "type": "host",
            "keyColor": "32"
        },
        {
            "key": "󰅐 uptime",
            "type": "uptime",
            "keyColor": "33"
        },
        {
            "key": "{icon} distro",
            "type": "os",
            "keyColor": "34"
        },
        {
            "key": " kernel",
            "type": "kernel",
            "keyColor": "35"
        },
        {
            "key": "󰏖 packages",
            "type": "packages",
            "keyColor": "36"
        },
        {
            "key": "󰇄 desktop",
            "type": "de",
            "keyColor": "31"
        },
        {
            "key": "󰖲 wm",
            "type": "wm",
            "keyColor": "32"
        },
        {
            "key": " term",
            "type": "terminal",
            "keyColor": "33"
        },
        {
            "key": " shell",
            "type": "shell",
            "keyColor": "34"
        },
        {
            "key": "󰍛 cpu",
            "type": "cpu",
            "showPeCoreCount": true,
            "keyColor": "35"
        },
        {
            "key": "󰢹 gpu",
            "type": "gpu",
            "keyColor": "36"
        },
        {
            "key": "󰍹 display",
            "type": "display",
            "keyColor": "31"
        },
        {
            "key": "󰉉 disk",
            "type": "disk",
            "folders": "/",
            "keyColor": "32"
        },
        {
            "key": "󰁹 battery",
            "type": "battery",
            "keyColor": "33"
        },
        {
            "key": " memory",
            "type": "memory",
            "keyColor": "34"
        },
        {
            "key": "󰩟 network",
            "type": "localip",
            "format": "{ipv4} ({ifname})",
            "keyColor": "35"
        },
        {
            "key": "󰗊 locale",
            "type": "locale",
            "keyColor": "36"
        },
        {
            "key": " colors",
            "type": "colors",
            "symbol": "circle",
            "keyColor": "39"
        }
    ]
}
