async def search_piratebay(query: str, max_results: int = 25) -> list[dict]:
    url = f"https://apibay.org/q.php?q={urllib.parse.quote(query)}"
    async with aiohttp.ClientSession(headers=HEADERS, trust_env=True) as session:
        data = await _fetch_json(session, url)
        if not data: return []

        results = []
        for item in data[:max_results]:
            if item.get("info_hash"):
                name = item.get("name", "Unknown")
                seeds = int(item.get("seeders", 0))
                size_bytes = int(item.get("size", 0))
                size = _format_size(size_bytes)
                magnet = f"magnet:?xt=urn:btih:{item['info_hash']}&dn={urllib.parse.quote(name)}"
                results.append({
                    "name": name, "seeds": seeds, "size": size,
                    "magnet": magnet, "source": "TPB", "poster": "",
                })
    return results


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
def _format_size(size_bytes: int) -> str:
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if size_bytes < 1024:
            return f"{size_bytes:.1f} {unit}"
        size_bytes /= 1024
    return f"{size_bytes:.1f} PB"


def filter_quality(results: list[dict], quality: str) -> list[dict]:
    if not quality: return results
    quality_lower = quality.lower()
    matching = [r for r in results if quality_lower in r["name"].lower()]
    return matching if matching else results


def sort_results(results: list[dict], sort_by: str) -> list[dict]:
    if sort_by == "seeds":
        return sorted(results, key=lambda r: r["seeds"], reverse=True)
    elif sort_by == "name":
        return sorted(results, key=lambda r: r["name"].lower())
    elif sort_by == "size":
        return sorted(results, key=lambda r: _parse_size(r["size"]), reverse=True)
    return results


def _parse_size(size_str: str) -> float:
    match = re.match(r"([\d.]+)\s*(B|KB|MB|GB|TB)?", size_str, re.I)
    if not match: return 0
    val = float(match.group(1))
    unit = (match.group(2) or "B").upper()
    multipliers = {"B": 1, "KB": 1024, "MB": 1024**2, "GB": 1024**3, "TB": 1024**4}
    return val * multipliers.get(unit, 1)


# ---------------------------------------------------------------------------
# Previewer Detection
# ---------------------------------------------------------------------------
def _supports_sixel() -> bool:
    if os.environ.get("TERM") in ["mlterm", "yaft-256color"]: return True
    if "sixel" in os.environ.get("TERM", "").lower(): return True

    try:
        if not sys.stdout.isatty(): return False
        fd = sys.stdout.fileno()
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            sys.stdout.write("\033[c")
            sys.stdout.flush()
            rlist, _, _ = select.select([fd], [], [], 0.1)
            if rlist:
                resp = os.read(fd, 1024).decode(errors="ignore")
                if "4" in resp.strip("\x1b[?").rstrip("c").split(";"):
                    return True
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
    except Exception:
        pass
    return False


def get_preview_cmd() -> str | None:
    term = os.environ.get("TERM", "")
    term_program = os.environ.get("TERM_PROGRAM", "").lower()

    # 1. Kitty
    if term == "xterm-kitty" or term_program == "kitty":
        if shutil.which("kitty") or shutil.which("chafa"):
            return "kitty-icat"
            
    # 2. Sixel (pure sixel via img2sixel or magick)
    if _supports_sixel():
        if shutil.which("img2sixel") or shutil.which("magick") or shutil.which("convert") or shutil.which("chafa"):
            return "sixel"
            
    # 3. Ueberzugpp
    if shutil.which("ueberzugpp"):
        return "ueberzugpp"
        
    # 4. Chafa
    if shutil.which("chafa"):
        return "chafa"
        
    return None

PREVIEW_CMD = get_preview_cmd()


# ---------------------------------------------------------------------------
# Ueberzugpp Daemon Management
# ---------------------------------------------------------------------------
def _kill_ueberzugpp_daemon(proc, pid_path: str):
    stale_pid = None
    if os.path.exists(pid_path):
        try:
            with open(pid_path) as f:
                stale_pid = int(f.read().strip())
        except (ValueError, OSError):
            pass

    socket_path = f"/tmp/ueberzugpp-{stale_pid}.socket" if stale_pid else None

    if socket_path and os.path.exists(socket_path):
        try:
            subprocess.run(
                ["ueberzugpp", "cmd", f"--socket={socket_path}",
                 "--identifier=torrent-mpv-poster", "--action=remove"],
                timeout=2, capture_output=True,
            )
        except Exception:
            pass

    pids = set()
    if proc: pids.add(proc.pid)
    if stale_pid: pids.add(stale_pid)

    for pid in pids:
        try:
            os.killpg(pid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError, OSError):
            try:
                os.kill(pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError, OSError):
                pass

    if proc:
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            pass

    for pid in pids:
        try:
            os.kill(pid, 0)
        except (ProcessLookupError, OSError):
            continue
        try:
            os.killpg(pid, signal.SIGKILL)
        except (ProcessLookupError, OSError):
            try:
                os.kill(pid, signal.SIGKILL)
            except (ProcessLookupError, OSError):
                pass

    if proc:
        try:
            proc.wait(timeout=1)
        except Exception:
            pass

    if socket_path:
        try: os.unlink(socket_path)
        except OSError: pass
    try: os.unlink(pid_path)
    except OSError: pass


# ---------------------------------------------------------------------------
# Background Image Pre-fetching
# ---------------------------------------------------------------------------
def _prefetch_posters_background(results: list[dict]):
    import urllib.request
    cache_dir = Path(tempfile.gettempdir()) / "torrent-mpv" / "posters"
    cache_dir.mkdir(parents=True, exist_ok=True)
    
    urls = {r.get("poster") for r in results if r.get("poster")}
    
    def _download_worker(url: str):
        filename = hashlib.md5(url.encode()).hexdigest() + ".jpg"
        filepath = cache_dir / filename
        if filepath.exists() and filepath.stat().st_size > 100:
            return
        try:
            req = urllib.request.Request(url, headers=HEADERS)
            with urllib.request.urlopen(req, timeout=10) as resp:
                data = resp.read()
                if len(data) > 100:
                    with open(filepath, "wb") as f:
                        f.write(data)
        except Exception:
            pass

    for url in urls:
        t = threading.Thread(target=_download_worker, args=(url,), daemon=True)
        t.start()


# ---------------------------------------------------------------------------
# Selection UI (fzf)
# ---------------------------------------------------------------------------
def select_with_fzf(results: list[dict]) -> dict | None:
    if not results:
        return None

    lines = []
    for i, r in enumerate(results):
        seed_str = f"{r['seeds']:>5d}"
        size_str = f"{r['size']:>9s}"
        name_str = r["name"][:90]
        lines.append(f"{i:3d}\t{seed_str}\t{size_str}\t{name_str}")

    results_file = os.path.join(TEMP_DIR, "results.json")
    with open(results_file, "w") as f:
        json.dump(results, f)

    _prefetch_posters_background(results)

    daemon_socket = None
    daemon_proc = None
    preview_script = SCRIPT_DIR / "torrent-mpv-preview"
    pid_path = str(TEMP_DIR / "ueberzugpp.pid")

    if PREVIEW_CMD == "ueberzugpp" and preview_script.exists():
        _kill_ueberzugpp_daemon(None, pid_path)

        daemon_proc = subprocess.Popen(
            ["ueberzugpp", "layer", "--no-stdin", "--silent", f"--pid-file={pid_path}"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )

        for _ in range(40):
            time.sleep(0.05)
            if os.path.exists(pid_path):
                try:
                    with open(pid_path) as pf:
                        daemon_pid = int(pf.read().strip())
                    socket_path = f"/tmp/ueberzugpp-{daemon_pid}.socket"
                    if os.path.exists(socket_path):
                        daemon_socket = socket_path
                        break
                except (ValueError, OSError):
                    pass

        if not daemon_socket:
            _kill_ueberzugpp_daemon(daemon_proc, pid_path)
            daemon_proc = None

    fzf_cmd = [
        "fzf", "--height=70%", "--reverse",
        "--header=↑↓ navigate · enter to stream · q/esc to cancel",
        "--with-nth=2..", "--delimiter=\t",
    ]

    if PREVIEW_CMD and preview_script.exists():
        socket_arg = daemon_socket if PREVIEW_CMD == "ueberzugpp" else "none"
        fzf_cmd += [
            "--preview", f"{sys.executable} {preview_script} {{n}} {PREVIEW_CMD} {socket_arg}",
            "--preview-window=right:22%:wrap",
        ]

    proc = None
    try:
        proc = subprocess.run(
            fzf_cmd, input="\n".join(lines), capture_output=True, text=True,
        )
    finally:
        if daemon_proc:
            _kill_ueberzugpp_daemon(daemon_proc, pid_path)
        if PREVIEW_CMD == "kitty-icat":
            sys.stdout.write("\033_Ga=d;\033\\")
            sys.stdout.flush()


    if proc is None or proc.returncode != 0:
        return None

    selected = proc.stdout.strip()
    if not selected:
        return None

    idx_str = selected.split("\t")[0].strip()
    try:
        idx = int(idx_str)
        return results[idx]
    except (ValueError, IndexError):
        return None


