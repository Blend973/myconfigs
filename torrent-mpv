async def search_yts(query: str, max_results: int = 25) -> list[dict]:
    async with aiohttp.ClientSession(headers=HEADERS, trust_env=True) as session:
        for api_url in YTS_APIS:
            params = {"query_term": query, "limit": max_results}
            data = await _fetch_json(session, api_url, params=params)
            if not data:
                continue

            results = []
            movies = data.get("data", {}).get("movies") or []
            for movie in movies:
                title = movie.get("title_long") or movie.get("title", "")
                year = movie.get("year", "")
                for t in movie.get("torrents", []):
                    hash_val = t.get("hash", "")
                    if not hash_val:
                        continue
                    quality = t.get("quality", "?")
                    seeds = t.get("seeds", 0)
                    size = t.get("size", "?")
                    magnet = f"magnet:?xt=urn:btih:{hash_val}&dn={urllib.parse.quote(title + ' ' + quality)}"
                    name = f"{title} ({year}) {quality} [{size}]"
                    poster = movie.get("large_cover_image") or movie.get("medium_cover_image") or ""
                    results.append({
                        "name": name, "seeds": int(seeds or 0), "size": size,
                        "magnet": magnet, "source": "YTS", "poster": poster,
                    })
                    if len(results) >= max_results: break
                if len(results) >= max_results: break
            if results: return results
    return []


async def search_eztv(query: str, max_results: int = 25) -> list[dict]:
    async with aiohttp.ClientSession(headers=HEADERS, trust_env=True) as session:
        for api_url in EZTV_APIS:
            params = {"keywords": query, "limit": max_results}
            data = await _fetch_json(session, api_url, params=params)
            if not data: continue

            results = []
            torrents = data.get("torrents") or []
            for t in torrents[:max_results]:
                title = t.get("title", "")
                magnet = t.get("magnet_url", "")
                if not magnet: continue
                seeds = t.get("seeds", 0)
                size_bytes = t.get("size_bytes", 0)
                try:
                    size = _format_size(int(size_bytes)) if size_bytes else "?"
                except (ValueError, TypeError):
                    size = str(size_bytes) if size_bytes else "?"
                results.append({
                    "name": title, "seeds": int(seeds or 0), "size": size,
                    "magnet": magnet, "source": "EZTV", "poster": "",
                })
            if results: return results
    return []


async def search_limetorrents(query: str, max_results: int = 25) -> list[dict]:
    async with aiohttp.ClientSession(headers=HEADERS, trust_env=True) as session:
        for mirror in LT_MIRRORS:
            url = f"{mirror}/search/all/{urllib.parse.quote(query)}/seeds/1/"
            html = await _fetch_html(session, url, timeout=20)
            if not html: continue

            soup = BeautifulSoup(html, "html.parser")
            results = []
            rows = soup.select("table.table2 tbody tr")

            for row in rows:
                if len(results) >= max_results: break
                name_el = row.select_one("td.tdleft a:nth-of-type(2)") or row.select_one("td a")
                if not name_el: continue
                name = name_el.get_text(strip=True)
                if not name or len(name) < 5: continue

                seed_el = row.select_one("td.tdseed")
                seeds_text = seed_el.get_text(strip=True) if seed_el else "0"
                size_el = row.select_one("td.tdsize")
                size = size_el.get_text(strip=True) if size_el else "?"

                magnet = None
                for a in row.find_all("a", href=True):
                    if a["href"].startswith("magnet:"):
                        magnet = a["href"]
                        break

                if not magnet:
                    href = name_el.get("href", "")
                    if href:
                        detail_url = href if href.startswith("http") else mirror + href
                        magnet = await _get_magnet(session, detail_url)

                if not magnet: continue
                results.append({
                    "name": name, "seeds": int(re.sub(r"[^\d]", "", seeds_text) or 0),
                    "size": size, "magnet": magnet, "source": "LimeTorrents", "poster": "",
                })
            if results: return results
    return []


