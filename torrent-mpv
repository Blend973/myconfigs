def stream_with_peerflix(magnet: str, player: str = "mpv"):
    cmd = ["peerflix", magnet, f"--{player}"]
    print(f"\n▶ Launching: {' '.join(cmd)}", file=sys.stderr)
    try:
        subprocess.run(cmd, check=True)
    except FileNotFoundError:
        print("peerflix not found. Install with: npm install -g peerflix", file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as e:
        print(f"peerflix exited with code {e.returncode}", file=sys.stderr)


