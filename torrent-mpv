def add_trackers(magnet: str) -> str:
    existing = magnet.count("&tr=")
    if existing >= 3: return magnet
    tracker_str = "".join(f"&tr={urllib.parse.quote(t)}" for t in PUBLIC_TRACKERS)
    return magnet + tracker_str


def stream_magnet(magnet: str, player: str = "mpv"):
    import socket as _socket
    magnet = add_trackers(magnet)

    subprocess.run(["pkill", "-f", "peerflix"], capture_output=True)
    time.sleep(0.5)

    print(f"\n▶ Starting stream...", file=sys.stderr)
    peerflix_proc = subprocess.Popen(
        ["peerflix", magnet, "--port", "8888"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )

    stream_url = "http://localhost:8888/"
    print("   Buffering...", file=sys.stderr)
    for i in range(120):
        time.sleep(1)
        try:
            sock = _socket.socket(_socket.AF_INET, _socket.SOCK_STREAM)
            sock.settimeout(2)
            result = sock.connect_ex(("127.0.0.1", 8888))
            sock.close()
            if result == 0:
                print(f"   Stream ready ({i+1}s)", file=sys.stderr)
                break
        except Exception:
            pass
    else:
        print("   Stream failed to start.", file=sys.stderr)
        peerflix_proc.kill()
        sys.exit(1)

    mpv_cmd = [player, "--force-window=immediate", stream_url]
    print(f"▶ {' '.join(mpv_cmd)}", file=sys.stderr)
    try:
        subprocess.run(mpv_cmd, check=True)
    except FileNotFoundError:
        print(f"{player} not found in PATH.", file=sys.stderr)
    except subprocess.CalledProcessError as e:
        print(f"{player} exited with code {e.returncode}", file=sys.stderr)
    finally:
        peerflix_proc.kill()


# ---------------------------------------------------------------------------
# Async search orchestrator
# ---------------------------------------------------------------------------
async def search_all(query: str, sites: list[str], max_results: int) -> list[dict]:
    search_map = {
        "yts": search_yts, "eztv": search_eztv, "tpb": search_piratebay,
        "limetorrents": search_limetorrents, "rarbg": search_rarbg,
    }

    tasks = []
    site_labels = []
    for site in sites:
        if site in search_map:
            tasks.append(search_map[site](query, max_results))
            site_labels.append(site.upper())

    print(f"   Querying {', '.join(site_labels)} (parallel)...", file=sys.stderr)
    raw_results = await asyncio.gather(*tasks, return_exceptions=True)

    all_results = []
    seen_magnets = set()
    for result_set in raw_results:
        if isinstance(result_set, Exception): continue
        for r in result_set:
            info_hash = r["magnet"].split("btih:")[1][:40] if "btih:" in r["magnet"] else r["magnet"]
            if info_hash not in seen_magnets:
                seen_magnets.add(info_hash)
                all_results.append(r)

    return all_results


