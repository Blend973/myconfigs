async def _fetch_json(session: aiohttp.ClientSession, url: str, **kwargs) -> dict | None:
    timeout = aiohttp.ClientTimeout(total=kwargs.pop("timeout", 15))
    try:
        async with session.get(url, timeout=timeout, **kwargs) as resp:
            if resp.status != 200:
                return None
            return await resp.json(content_type=None)
    except (aiohttp.ClientError, asyncio.TimeoutError):
        return None


async def _fetch_html(session: aiohttp.ClientSession, url: str, **kwargs) -> str | None:
    timeout = aiohttp.ClientTimeout(total=kwargs.pop("timeout", 15))
    try:
        async with session.get(url, timeout=timeout, **kwargs) as resp:
            if resp.status != 200:
                return None
            return await resp.text()
    except (aiohttp.ClientError, asyncio.TimeoutError):
        return None


async def _get_magnet(session: aiohttp.ClientSession, page_url: str) -> str | None:
    html = await _fetch_html(session, page_url, timeout=15)
    if not html:
        return None
    soup = BeautifulSoup(html, "html.parser")
    for a in soup.find_all("a", href=True):
        if a["href"].startswith("magnet:"):
            return a["href"]
    return None


