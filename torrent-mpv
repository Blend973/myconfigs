# Main
# ---------------------------------------------------------------------------
def main():
    args = sys.argv[1:]

    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)

    if args[0] == "--config":
        config = load_config()
        print(json.dumps(config, indent=2))
        sys.exit(0)

    config = load_config()

    query_parts = []
    quality_override = None
    i = 0
    while i < len(args):
        if args[i] == "--quality" and i + 1 < len(args):
            quality_override = args[i + 1]
            i += 2
        elif args[i].startswith("--q="):
            quality_override = args[i].split("=", 1)[1]
            i += 1
        else:
            query_parts.append(args[i])
            i += 1

    query = " ".join(query_parts)
    if not query:
        print("Usage: torrent-mpv <search query>", file=sys.stderr)
        sys.exit(1)

    quality = quality_override or config.get("preferred_quality", "")
    max_results = config.get("max_results", 25)
    min_seeds = config.get("min_seeds", 0)
    sites = config.get("sites", ["yts", "eztv", "tpb", "limetorrents", "rarbg"])
    sort_by = config.get("sort_by", "seeds")

    print(f"⚡ Searching for: {query}", file=sys.stderr)
    if quality:
        print(f"   Quality filter: {quality}", file=sys.stderr)

    all_results = asyncio.run(search_all(query, sites, max_results))

    all_results = [r for r in all_results if r["seeds"] >= min_seeds]
    all_results = filter_quality(all_results, quality)
    all_results = sort_results(all_results, sort_by)[:max_results]

    if not all_results:
        print("No results found. Try a different query or lower min_seeds.", file=sys.stderr)
        sys.exit(1)

    print(f"   Found {len(all_results)} results\n", file=sys.stderr)
    selected = select_with_fzf(all_results)

    if not selected:
        print("Cancelled.", file=sys.stderr)
        sys.exit(0)

    print(f"\n✓ Selected: {selected['name']}", file=sys.stderr)
    print(f"  Seeds: {selected['seeds']}  Size: {selected['size']}", file=sys.stderr)

    player = config.get("player", "mpv")
    stream_magnet(selected["magnet"], player)


if __name__ == "__main__":
    main()
